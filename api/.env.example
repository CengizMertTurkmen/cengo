# Instagram Graph API (artık kullanılmıyor - OAuth ile otomatik alınır)
# INSTAGRAM_USER_ID ve INSTAGRAM_ACCESS_TOKEN kaldırıldı

# Cloudinary (cloudinary.com → ücretsiz hesap aç)
CLOUDINARY_CLOUD_NAME=senin_cloud_adin
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Meta App (developers.facebook.com → uygulama oluştur)
META_APP_ID=123456789012345
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sunucu adresi (OAuth callback için)
BASE_URL=https://senin-sunucun.com

# Müşteriye verilen API anahtarı (X-Api-Key header'ında gönderilir)
API_KEY=guclu_ve_rastgele_bir_anahtar

# Ortam: "production" → Swagger /docs gizlenir, "development" → açık kalır
ENV=production

# Token izleme bildirimleri (opsiyonel)
# Boş bırakılırsa webhook gönderilmez, sadece /health/tokens endpoint'i çalışır
WEBHOOK_URL=https://senin-webhook-urlun.com/notify
# Token'ın kaç gün kala uyarı verilsin (varsayılan: 7)
WEBHOOK_DAYS_BEFORE=7
