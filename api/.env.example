# Instagram Graph API (artık kullanılmıyor - OAuth ile otomatik alınır)
# INSTAGRAM_USER_ID ve INSTAGRAM_ACCESS_TOKEN kaldırıldı

# Cloudinary (cloudinary.com → ücretsiz hesap aç)
CLOUDINARY_CLOUD_NAME=senin_cloud_adin
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Meta App (developers.facebook.com → uygulama oluştur)
META_APP_ID=123456789012345
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sunucu adresi (OAuth callback için)
BASE_URL=https://senin-sunucun.com
